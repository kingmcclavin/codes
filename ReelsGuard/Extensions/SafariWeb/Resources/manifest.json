{
  "manifest_version": 3,
  "name": "Reels Guard",
  "description": "Watch Reels you intentionally open. Stops instagram.com from turning them into an endless recommendation feed.",
  "version": "1.0",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://instagram.com/*", "*://*.instagram.com/*"],
      "js": ["reels-observer.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["nativeMessaging"],
  "host_permissions": ["*://instagram.com/*", "*://*.instagram.com/*"]
}
